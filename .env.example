# Database connection string (Neon Postgres in production, local Postgres via docker-compose for dev)
DATABASE_URL=postgresql://payload:payload@127.0.0.1:5432/payload

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Vercel Blob read/write token for the media collection's file storage.
# Set automatically by Vercel when a Blob store is linked to the project.
# If unset, uploads fall back to local disk storage (fine for local dev).
BLOB_READ_WRITE_TOKEN=
